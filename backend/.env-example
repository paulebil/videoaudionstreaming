APP_NAME=videoaudionstreaming
FRONTEND_HOST=http://localhost:3000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_db

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=video_db

JWT_SECRET=super-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Video Audio Streaming
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_SERVER=smtp.gmail.com
SMTP_STARTTLS=true
SMTP_SSL_TLS=false
SMTP_DEBUG=false
USE_CREDENTIALS=true

RUSTFS_ACCESS_KEY=rustfs-access-key
RUSTFS_SECRET_KEY=rustfs-secret-key
RUSTFS_BUCKET_NAME=media-bucket
RUSTFS_ENDPOINT=http://localhost:9000

MAX_VIDEO_SIZE=1073741824
MAX_AUDIO_SIZE=104857600

PRESIGNED_URL_EXPIRY=3600
USE_BACKGROUND_TASKS=true

REDIS_URL=redis://localhost:6379

ELASTICSEARCH_URL=http://localhost:9200